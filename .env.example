# Copy this file's KEYS into Render -> your service -> Environment tab.
# Never commit the real .env file - it stays only on your PC and in Render's dashboard.

SECRET_KEY=

# ---- MongoDB (use a free MongoDB Atlas cluster for Render) ----
MONGO_URI=
MONGO_DB=srj_bot

# ---- Website / QR code ----
# Must be the real https URL Render gives you, e.g. https://your-app.onrender.com
PUBLIC_URL=
QR_URL=

# ---- First admin (saved in MongoDB on first run) ----
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---- Optional WhatsApp Cloud API (Meta) ----
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
NOTIFY_NUMBER=

# ---- GST verification + automatic UC code ----
GST_PROVIDER=
GST_API_KEY=
GST_STRICT=
GST_CACHE_DAYS=
UC_PREFIX=
UC_START=

# ---- Automatic email of the enquiry PDF to admin(s) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_NOTIFY=
MAIL_NOTIFY_EXTRA=

# ---- Google Sheet price/stock (needs service_account.json uploaded as a Render Secret File) ----
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
SHEET_QUOTE=
SHEET_CACHE_MINUTES=

SALES_MAIL=
SALES_QUOTE=
